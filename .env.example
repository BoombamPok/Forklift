# Copy to .env.local and fill in from your Supabase project's Connect
# dialog, or Settings > API Keys. Never commit .env.local - it's gitignored.

# Public - safe to expose in the browser bundle. The publishable key
# carries the same low privilege as the old "anon" key (Supabase is
# retiring anon/service_role keys in favor of these by end of 2026).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only - never reference this from a Client Component. Bypasses RLS
# like the old "service_role" key did. Used only behind
# `import "server-only"` (see src/lib/supabase/admin.ts).
SUPABASE_SECRET_KEY=
