# Copy to .env.local and fill in from your Supabase project's
# Settings > API page. Never commit .env.local - it's gitignored.

# Public - safe to expose in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only - never reference this from a Client Component. Used only
# behind `import "server-only"` (see src/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=
