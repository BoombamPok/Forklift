# Copy to .env.local and fill in from your Supabase project's Connect
# dialog, or Settings > API Keys. Never commit .env.local - it's gitignored.

# Public - safe to expose in the browser bundle. The publishable key
# carries the same low privilege as the old "anon" key (Supabase is
# retiring anon/service_role keys in favor of these by end of 2026).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only - never reference this from a Client Component. Bypasses RLS
# like the old "service_role" key did. Used only behind
# `import "server-only"` (see src/lib/supabase/admin.ts).
SUPABASE_SECRET_KEY=

# Optional - a dedicated synthetic Supabase Auth user (not a real
# account) for e2e/auth.spec.ts's live login/logout test. Create one via
# the Admin Auth API and put its own credentials here; the test suite
# skips itself if these are unset.
E2E_SUPABASE_TEST_EMAIL=
E2E_SUPABASE_TEST_PASSWORD=

# Optional - a second dedicated synthetic Supabase Auth user with role
# 'admin' (not a real account), for e2e/admin.spec.ts's admin-only-action
# coverage. Provision via `node scripts/create-e2e-admin.mjs`, which prints
# the values to put here. The test suite skips itself if these are unset.
E2E_ADMIN_TEST_EMAIL=
E2E_ADMIN_TEST_PASSWORD=

# Optional - the site's real production URL (e.g. https://forkstock.com),
# used only to build the link inside a user-invite email
# (src/lib/site-url.ts). Falls back to Vercel's own auto-injected
# VERCEL_URL, then http://localhost:3000 - only needed if you're on a
# custom domain rather than the default *.vercel.app one.
NEXT_PUBLIC_SITE_URL=
